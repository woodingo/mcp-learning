# Пример systemd unit файла.
# Замените <USER> и <PROJECT_DIR> на свои значения перед копированием:
#   sed -e 's/<USER>/'$USER'/g' -e 's|<PROJECT_DIR>|'"$(pwd)"'|g' mcp-server.service | sudo tee /etc/systemd/system/mcp-server.service

[Unit]
Description=MCP Learning Server
After=network.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=<PROJECT_DIR>
ExecStart=/usr/bin/node <PROJECT_DIR>/build/http.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=<PROJECT_DIR>/.env

[Install]
WantedBy=multi-user.target
